FROM logs-windows.security-*
| WHERE @timestamp >= now() - 24h
| WHERE event.code IN ("4724", "4725", "4738")
    AND host.os.type == "windows"
| STATS
    modifications   = COUNT(*),
    unique_targets  = COUNT_DISTINCT(winlog.event_data.TargetUserName),
    target_accounts = VALUES(winlog.event_data.TargetUserName),
    first_seen      = MIN(@timestamp),
    last_seen       = MAX(@timestamp)
  BY winlog.event_data.SubjectUserName, source.ip
| EVAL duration_seconds = DATE_DIFF("seconds", first_seen, last_seen)
| WHERE unique_targets > 100 AND duration_seconds < 600
| SORT unique_targets DESC
| LIMIT 100
