from logs-endpoint.events.registry-*
| where event.category == "registry"
    and host.type == "workstation"
    and host.tag  == "operations"
    and registry.data.strings is not null
    and (
      registry.path like "*\\\\Run\\\\*"
      or registry.path like "*\\\\RunOnce\\\\*"
    )
| eval run_command = registry.data.strings
| stats
    occurrences = count(*),
    host_count  = count_distinct(host.id),
    first_seen  = min(@timestamp),
    last_seen   = max(@timestamp)
  by run_command
| sort host_count asc, occurrences asc
