registry where
  host.os.type   == "windows"
  and event.category == "registry"
  and event.action in ("query", "open", "read")
  and (
    registry.path : (
      "HKLM\\SAM*",
      "\\REGISTRY\\MACHINE\\SAM*",
      "HKLM\\SECURITY*",
      "\\REGISTRY\\MACHINE\\SECURITY*"
    )
    or registry.key : ("HKLM\\SAM", "HKLM\\SECURITY")
  )
  and not process.name : ("lsass.exe", "services.exe", "svchost.exe")
