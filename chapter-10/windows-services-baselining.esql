from logs-endpoint.events.system-*
| where @timestamp >= now() - 30d
  and host.os.type == "windows"
  and event.code in ("7045", "4697")
  and winlog.event_data.ServiceName is not null
  and winlog.event_data.ImagePath  is not null
| eval service_name = winlog.event_data.ServiceName
| eval image_path   = winlog.event_data.ImagePath
| stats
    occurrences = count(*),
    host_count  = count_distinct(host.id),
    first_seen  = min(@timestamp),
    last_seen   = max(@timestamp)
  by service_name, image_path
| where host_count <= 5
| sort host_count asc, last_seen desc
