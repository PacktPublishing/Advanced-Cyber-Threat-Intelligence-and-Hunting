{
  "job_id": "suspicious_api_requests_v1",
  "analysis_config": {
    "bucket_span": "5m",
    "detectors": [
      {
        "function": "rare",
        "by_field_name": "url.path",
        "partition_field_name": "host.name",
        "detector_index": 0
      },
      {
        "function": "high_count",
        "by_field_name": "url.path",
        "partition_field_name": "host.name",
        "detector_index": 1
      },
      {
        "function": "high_distinct_count",
        "field_name": "requests_query_signature",
        "partition_field_name": "host.name",
        "detector_index": 2
      }
    ],
    "influencers": [
      "requests_query.signature ",
      "url.query",
      "source.ip"
    ]
  },
  "analysis_limits": {
    "model_memory_limit": "128mb"
  },
  "model_plot_config": {
    "enabled": true,
    "annotations_enabled": true
  }
}
